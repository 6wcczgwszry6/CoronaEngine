<CoronaBlocksDocument schemaVersion="1" documentPurpose="ai-generation-contract" projectName="CoronaEngine AI Template">
  <AiContract>
    <Purpose>This file is the CoronaEngine node/block generation contract for Gemini or any AI model. After the AI rewrites this XML according to your demo requirement, CoronaEngine can import it and restore the project-level node graph, blocks, edges, and layout.</Purpose>
    <HowToAskAi><![CDATA[Send this XML file to the AI together with your demo/gameplay requirement. The AI must: Return ONLY one complete CoronaBlocksDocument XML document; do NOT use Markdown; fill ProjectGraph/Workspace, nodes, edges, Blockly block JSON, layout positions, and GeneratedCode.]]></HowToAskAi>
    <AiPromptTemplate><![CDATA[You are a CoronaEngine node/block XML generator. Read this XML contract and my requirement, then Return ONLY one complete CoronaBlocksDocument XML document; do NOT use Markdown; fill ProjectGraph/Workspace, nodes, edges, Blockly block JSON, layout positions, and GeneratedCode. Requirement: <write the desired demo effect here>.]]></AiPromptTemplate>
    <ImportTarget fixedId="node_graph:project:global" binding="project-global-only" />
    <Rules>
      <Rule>Root element must be CoronaBlocksDocument and schemaVersion must be 1.</Rule>
      <Rule>The main graph is project-level and persistent; it is not bound to any actor, scene, or target.</Rule>
      <Rule>Import always restores to node_graph:project:global.</Rule>
      <Rule>ProjectGraph/Workspace must contain valid node-graph-json inside CDATA.</Rule>
      <Rule>nodes describes graph nodes; each node should include id, macroType, nodeType, name, customName, x, y, and workspace.</Rule>
      <Rule>Node layout positions are stored in node.x and node.y.</Rule>
      <Rule>Blocks inside nodes are stored in node.workspace using official Blockly JSON serialization.</Rule>
      <Rule>edges describes graph links; source/target point to node id, side, and index.</Rule>
      <Rule>Condition blocks are stored in edge.conditionWorkspace using Blockly JSON serialization.</Rule>
      <Rule>Global variable/list block pools are stored in globalVariablesWorkspace.</Rule>
      <Rule>GeneratedCode must be project-level Python and should match the visible node/block graph logic.</Rule>
      <Rule>If a block shape is uncertain, keep the workspace valid/empty and put runnable behavior in GeneratedCode; the file remains importable.</Rule>
    </Rules>
  </AiContract>
  <AiGenerationGuide>
    <RequiredOutput>Return ONLY one complete CoronaBlocksDocument XML document; do NOT use Markdown; fill ProjectGraph/Workspace, nodes, edges, Blockly block JSON, layout positions, and GeneratedCode.</RequiredOutput>
